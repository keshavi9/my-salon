# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development          # Set to 'production' on your production server

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:password@localhost:5432/salon_crm

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=<min_64_char_random_string>
JWT_EXPIRES_IN=7d

# Set to 'true' only during onboarding to allow staff self-registration.
# Remove or set to 'false' once all accounts are created.
ALLOW_REGISTRATION=false

# ── Frontend ──────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ── Email (Nodemailer) ────────────────────────────────────────────────────────
EMAIL_USER=support@hairahmedabad.com
EMAIL_PASSWORD=<app_password>
DEV_TEAM_EMAIL=dev-team@hairahmedabad.com

# ── Razorpay ──────────────────────────────────────────────────────────────────
# Required for webhook signature verification. Get from Razorpay Dashboard → Webhooks.
RAZORPAY_WEBHOOK_SECRET=<your_razorpay_webhook_secret>
